DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Seed script storage cap (Neon free tier = 512 MB per project)
NEON_STORAGE_LIMIT_MB=512
SEED_MAX_FILL_PERCENT=83

# Email OTP — Gmail SMTP does NOT work on Render free tier (ports 587/465 blocked).
# Use Brevo (recommended) or Resend over HTTPS instead:
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER_EMAIL=sohamshrinagar19022006@gmail.com

# Alternative: Resend (requires domain verify to email non-account addresses)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=SearchSphere <onboarding@resend.dev>

# Local dev only — falls back to console log if no API keys above
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
